// Grably on Cloudflare (see README → "Deploy to Cloudflare")
//  - public/ is served as static assets from Cloudflare's network
//  - cloudflare/worker.ts sends /api/* to a Container running the Python download server (./Dockerfile)
{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Must match the Worker's name in the Cloudflare dashboard
	"name": "grably-downloader",
	"main": "cloudflare/worker.ts",
	"compatibility_date": "2026-10-30",
	"observability": { "enabled": true },

	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// Only these paths run the Worker; CSS, JS, fonts and images are served directly.
		"run_worker_first": ["/", "/index.html", "/api/*", "/ads.txt"]
	},

	"containers": [
		{
			"class_name": "GrablyServer",
			"image": "./Dockerfile",
			// 1/2 vCPU, 4 GiB memory, 8 GB disk: room for yt-dlp + ffmpeg and 500 MB downloads.
			// "basic" (1/4 vCPU, 1 GiB, 4 GB) costs less if traffic is light.
			"instance_type": "standard-1",
			"max_instances": 2
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "GRABLY", "class_name": "GrablyServer" }]
	},
	"exports": {
		"GrablyServer": { "type": "durable-object", "storage": "sqlite" }
	},

	"vars": {
		// Google AdSense: publisher ID (ca-pub-...) and display ad unit ID. Leave empty for no ads.
		"ADSENSE_CLIENT": "",
		"ADSENSE_SLOT": "",
		// "1" offers MP3 downloads, "0" turns them off
		"GRABLY_AUDIO": "1"
	}
	// Optional secret (Workers → Settings → Variables and Secrets): GRABLY_SECRET, a long random
	// string used to sign thumbnail links so they keep working after the container restarts.
}
