{
  "name": "grably",
  "private": true,
  "description": "Grabbly website on Cloudflare: Worker + static assets + a Container running the Python download server",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "check": "wrangler types && tsc --noEmit && wrangler deploy --dry-run --containers-rollout=none --outdir .wrangler/dry-run"
  },
  "devDependencies": {
    "@cloudflare/containers": "0.3.7",
    "typescript": "7.0.2",
    "wrangler": "4.156.0"
  }
}
